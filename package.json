{
  "name": "controle-de-vendas",
  "version": "2.0.1",
  "description": "Sistema para controle de vendas e gastos",
  "main": "./dist/main/main.js",
  "scripts": {
    "install": "cd renderer && npm i",
    "build:main": "tsc",
    "build:renderer": "cd renderer && npm run build",
    "build": "npm run build:main && npm run build:renderer",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migrate:create": "sh -c 'npm run typeorm -- migration:create ./src/database/migrations/$1' --",
    "migrate:up": "npm run typeorm -- -d ./src/database/datasource.ts migration:run",
    "migrate:down": "npm run typeorm -- -d ./src/database/datasource.ts migration:revert",
    "start": "electron .",
    "watch": "nodemon --exec electron .",
    "package": "electron-forge package",
    "make:32": "electron-forge make --arch=ia32",
    "make:64": "electron-forge make --arch=x64",
    "publish": "electron-forge publish"
  },
  "author": {
    "name": "joaolucenalima",
    "email": "joaovitorlucena000@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "electron-squirrel-startup": "1.0.0",
    "reflect-metadata": "0.2.2",
    "sqlite3": "5.1.7",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@electron-forge/cli": "6.0.5",
    "@electron-forge/maker-deb": "7.8.2",
    "@electron-forge/maker-squirrel": "6.0.5",
    "@electron-forge/publisher-github": "7.8.2",
    "@types/node": "^24.1.0",
    "electron": "22.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "4.9.5"
  }
}
